{
  "name": "dynamic-chess",
  "version": "0.1.2",
  "description": "A dynamic and responsive chessboard in Next.js/React with customizable dimensions and specific movement pieces.",
  "author": {
    "name": "Robson H. Rodrigues",
    "url": "https://github.com/Robson16"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://dynamic-chess.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Robson16/dynamic-chess.git"
  },
  "bugs": {
    "url": "https://github.com/Robson16/dynamic-chess/issues"
  },
  "keywords": [
    "ReactJs",
    "TypeScript",
    "NextJS",
    "Chess",
    "Game",
    "Dynamic Board"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "check-up": "npm run format && npm run lint:fix",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.10",
    "sass": "1.105.1",
    "typescript": "6.0.3"
  }
}
